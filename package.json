{
  "name": "claudiopiloto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local dashboard for Claude Code sessions, agents, usage, todos and Jira/Slack news.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "npm run build && NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/pixelify-sans": "^5.2.0",
    "@fontsource/share-tech-mono": "^5.2.0",
    "@fontsource/space-mono": "^5.2.0",
    "@fontsource/vt323": "^5.2.0",
    "@hono/node-server": "^1.19.0",
    "@tanstack/react-query": "^5.90.0",
    "hono": "^4.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
